    grf {
        grfid                              :"KLTS"; 
        name                               :string(STR_GRF_NAME);
        desc                               :string(STR_GRF_DESC);
        url                                :string(STR_GRF_URL);
        version                            :260406;
        min_compatible_version             :250204;

        // Parameters
            param  0    {
                para_speed_power {
                    type:       int;
                    name:       string(STR_PARA_NAME_SPEED_POWER);
                    desc:       string(STR_PARA_DESC_SPEED_POWER);
                    min_value:  2;
                    max_value:  4;
                    def_value:  2;
                        
                    names: {
                        2:      string(STR_PARA_SPEED_POWER_OPT_1);
                        3:      string(STR_PARA_SPEED_POWER_OPT_1_5);
                        4:      string(STR_PARA_SPEED_POWER_OPT_2);
                    };
                }
            }

            param  1    {
                para_capacity {
                    type:       int;
                    name:       string(STR_PARA_NAME_CAPA);
                    desc:       string(STR_PARA_DESC_CAPA);
                    min_value:  1;
                    max_value:  2;
                    def_value:  1;
                        
                    names: {
                        1:      string(STR_PARA_CAPA_OPT_1);
                        2:      string(STR_PARA_CAPA_OPT_2);
                    };
                }
            }
    }

// Tables
    cargotable {
        // TTD https://newgrf-specs.tt-wiki.net/wiki/CargoTypes#Cargo_Labels
            PASS, COAL, MAIL, OIL_, LVST, GOOD, GRAI, WOOD, IORE, STEL, VALU, PAPR, WHEA, FOOD, GOLD, RUBR,
            FRUT, MAIZ, CORE, WATR, DIAM, SUGR,

        // Toys
            BATT, BUBL, COLA, CTCD, FZDR, PLST, SWET, TOFF, TOYS,

        // FIRS 5.0.0-beta-3 https://grf.farm/firs/5.0.0-beta-3/html/code_reference.html
            ACID, GRVL, BEER, ALUM, NH3_, BEAN, STBL, BDMT, CBLK, CASS, CSTI, CMNT, RFPR, KAOL, CHLO, CLAY,
            SOAP, CTAR, JAVA, COKE, CCPR, COPR, EOIL, POWR, ENSP, BOOM, FMSP, FEAL, FERT, FISH, FOCA, GLAS,
            HWAR, LIME, MNO2, STBR, MILK, NITR, N7__, NUTS, O2__, COAT, PEAT, PETR, PHOS, IRON, PPWK, POTA,
            PUMP, PORE, QLME, RBAR, SALT, SAND, SCMT, SEAL, SLAG, SASH, LYE_, STIG, STPP, STSH, STSL, STTB,
            STWR, STSE, SULP, WDPR, TYCO, TYRE, VBOD, VENG, VPTS, VEHI, WELD, WOOL, ZINC,

        // FIRS 5.0.0-beta-5 https://grf.farm/firs/5.0.0-beta-5/html/code_reference.html
            PLNT, STPL, STSW
    }

    railtypetable {
        RAIL, ELRL, KRNR
    }

// Templates & General Swithes
    template tmpl_purchase(x, y) {
        [x,      y,   75,     15,   -39,   -9]
    }

    template tmpl_purchase_long(x, y) {
        [x,      y,   100,     15,   -39,   -9]
    }

    template tmpl_vehicle_8(x, y) {
        [x,      y,     8,    34,    -3,  -18] // ↑
        [x+20,   y,    29,    24,   -21,  -12] // ↗
        [x+60,   y,    48,    15,   -32,  -11] // →
        [x+120,  y,    29,    24,   -14,  -16] // ↘
        [x+160,  y,     8,    34,    -3,  -18] // ↓
        [x+180,  y,    29,    24,   -13,  -16] // ↙
        [x+220,  y,    48,    15,   -16,  -11] // ←
        [x+280,  y,    29,    24,   -10,  -14] // ↖
    }

    template tmpl_vehicle_12(x, y) {
        [x,      y,     8,    34,    -3,  -18] // ↑
        [x+20,   y,    29,    24,   -17,  -14] // ↗
        [x+60,   y,    48,    15,   -24,  -11] // →
        [x+120,  y,    29,    24,   -10,  -14] // ↘
        [x+160,  y,     8,    34,    -3,  -18] // ↓
        [x+180,  y,    29,    24,   -17,  -14] // ↙
        [x+220,  y,    48,    15,   -24,  -11] // ←
        [x+280,  y,    29,    24,   -10,  -14] // ↖
    }

    template tmpl_vehicle_14(x, y) {
        [x,      y,     8,    38,    -3,  -20] // ↑
        [x+20,   y,    33,    26,   -19,  -15] // ↗
        [x+60,   y,    56,    15,   -28,  -11] // →
        [x+120,  y,    33,    26,   -12,  -15] // ↘
        [x+160,  y,     8,    38,    -3,  -20] // ↓
        [x+180,  y,    33,    26,   -19,  -15] // ↙
        [x+220,  y,    56,    15,   -28,  -11] // ←
        [x+280,  y,    33,    26,   -12,  -15] // ↖
    }

    template tmpl_vehicle_empty(x, y) {
        [x,      y,     1,     1,     0,    0] // ↑
        [x,      y,     1,     1,     0,    0] // ↗
        [x,      y,     1,     1,     0,    0] // →
        [x,      y,     1,     1,     0,    0] // ↘
        [x,      y,     1,     1,     0,    0] // ↓
        [x,      y,     1,     1,     0,    0] // ↙
        [x,      y,     1,     1,     0,    0] // ←
        [x,      y,     1,     1,     0,    0] // ↖
    }

    switch (FEAT_TRAINS, SELF, sw_car_length_9, position_in_articulated_veh) {
        1: 5;
        2;
    }

    switch (FEAT_TRAINS, SELF, sw_car_length_12, position_in_articulated_veh) {
        1: 8;
        2;
    }

    switch (FEAT_TRAINS, SELF, sw_length_multiple_unit_4_cars, position_in_articulated_veh) {
        1: 8; // #01
        2: 4;
        3: 8; // #02
        4: 4;
        5: 8; // #03
        6: 4;
        7: 8; // #04
        2;
    }

    switch (FEAT_TRAINS, SELF, sw_length_multiple_unit_6_cars, position_in_articulated_veh) {
        1: 8; // #01
        2: 4;
        3: 8; // #02
        4: 4;
        5: 8; // #03
        6: 4;
        7: 8; // #04
        8: 4;
        9: 8; // #05
        10: 4;
        11: 8; // #06
        2;
    }

    switch (FEAT_TRAINS, SELF, sw_length_multiple_unit_8_cars, position_in_articulated_veh) {
        1: 8; // #01
        2: 4;
        3: 8; // #02
        4: 4;
        5: 8; // #03
        6: 4;
        7: 8; // #04
        8: 4;
        9: 8; // #05
        10: 4;
        11: 8; // #06
        12: 4;
        13: 8; // #07
        14: 4;
        15: 8; // #08
        2;
    }

    switch (FEAT_TRAINS, SELF, sw_length_multiple_unit_16_cars, position_in_articulated_veh) {
        0: 3;
        1: 8; // #01
        2: 5;
        3: 8; // #02
        4: 4;
        5: 8; // #03
        6: 4;
        7: 8; // #04
        8: 4;
        9: 8; // #05
        10: 4;
        11: 8; // #06
        12: 4;
        13: 8; // #07
        14: 4;
        15: 8; // #08
        16: 4;
        17: 8; // #09
        18: 4;
        19: 8; // #10
        20: 4;
        21: 8; // #11
        22: 4;
        23: 8; // #12
        24: 4;
        25: 8; // #13
        26: 4;
        27: 8; // #14
        28: 4;
        29: 8; // #15
        30: 5;
        31: 8; // #16
        32: 3;
        2;
    }

    spriteset(set_vehicle_empty, "./Korean_Longer_Train_Set/gfx/LONGER_BIDULGI_CAR.png"){
        tmpl_vehicle_empty(80, 0)
    }

// Passenger Wagons
    // BIDULGI_MILDSTEAL_CAR
        // Graphics
            spriteset(set_LONGER_BIDULGI_MILDSTEAL_CAR_purchase, "./Korean_Longer_Train_Set/gfx/LONGER_BIDULGI_CAR.png") {
                tmpl_purchase(0, 0)
            }

            spriteset(set_graphic_LONGER_BIDULGI_MILDSTEAL_PASS_A_CAR, "./Korean_Longer_Train_Set/gfx/LONGER_BIDULGI_CAR.png"){
                tmpl_vehicle_12(80, 0)
